{
  "name": "functions",
  "scripts": {
    "prebuild": "pnpm dlx supabase gen types typescript --project-id hwurcromdvurlylkviip --schema private > generated/database.types.ts",
    "build": "tsgo",
    "build:watch": "tsgo --watch",
    "serve": "pnpm run build && firebase emulators:start --only functions",
