    "firebase": "^12.7.0",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.1.1",
    "node-fetch": "^3.3.2",
    "ts-extras": "^0.17.0",
    "uuid": "^13.0.0",
    "zod": "^4.3.4"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
